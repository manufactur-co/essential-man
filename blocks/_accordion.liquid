{% if block.settings.title != blank and block.settings.content != blank %}
  {%- capture accordion_content -%}
    {{- block.settings.content -}}
  {%- endcapture -%}
  {% render 'mfr-component__accordion',
    block_id: block.id,
    trigger_label: block.settings.title,
    content: accordion_content,
    initially_open: block.settings.initially_open %}
{% endif %}

{%- schema -%}
  {
    "name": "Accordion",
    "class": "accordion__wrapper",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Frequently asked question?"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>Your answer goes here. Provide clear, helpful information to assist your customers.</p>"
      },
      {
        "type": "header",
        "content": "Accordion Settings"
      },
      {
        "type": "checkbox",
        "id": "initially_open",
        "label": "Initially Open?",
        "default": false
      }
    ],
    "presets": [
      {
        "name": "Accordion"
      }
    ]
  }
{%- endschema -%}